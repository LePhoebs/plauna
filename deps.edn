{:paths ["src" "classes" "resources"]
 :aliases {:build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.3" :git/sha "15ead66"}}
                   :ns-default build
                   :jvm-opts ["-Dclojure.compiler.direct-linking=true" "-Xmx4000m"]}
           :cider-clj {:extra-deps {cider/cider-nrepl {:mvn/version "1.5.1"}
                                    org.mockito/mockito-core {:mvn/version "5.24.0"}}
                       ;:classpath-overrides {org.clojure/clojure nil}
                       :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}
           :1.12-storm
           {;; for disabling the official compiler
            :classpath-overrides {org.clojure/clojure nil}
            :extra-deps {com.github.flow-storm/clojure {:mvn/version "1.12.3"}
                         com.github.flow-storm/flow-storm-dbg {:mvn/version "4.5.9"}
                         cider/cider-nrepl {:mvn/version "0.57.0"}}
            :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               org.mockito/mockito-core {:mvn/version "5.24.0"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :clj-watson {:replace-deps
               {io.github.clj-holmes/clj-watson
                {:git/tag "v6.0.1" :git/sha "b520351"}}
               :main-opts ["-m" "clj-watson.cli"]}}
 :deps {clj-http/clj-http {:mvn/version "3.13.1"}
        cheshire/cheshire {:exclusions [com.fasterxml.jackson.core/jackson-core] :mvn/version "6.2.0"}
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.22.4"}
        commons-codec/commons-codec {:mvn/version "1.23.0"}
        commons-io/commons-io {:mvn/version "2.22.0"}
        commons-net/commons-net {:mvn/version "3.13.0"}
        compojure/compojure {:mvn/version "1.7.2"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        com.github.seancorfield/honeysql {:mvn/version "2.8.85"}
        com.taoensso/telemere-slf4j {:mvn/version "1.4.0"}
        com.taoensso/telemere {:mvn/version "1.4.0"}
        io.github.emidln/cld {:mvn/version "0.2.0"}
        jakarta.mail/jakarta.mail-api {:mvn/version "2.1.5"}
        nrepl/nrepl {:mvn/version "1.8.0"}
        org.apache.james/apache-mime4j {:mvn/version "0.8.15" :extension "pom"}
        org.apache.opennlp/opennlp-tools {:mvn/version "2.5.12"}
        org.clj-commons/claypoole {:mvn/version "1.2.2"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/core.cache {:mvn/version "1.2.999"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/java.data {:mvn/version "1.4.120"}
        org.eclipse.angus/angus-mail {:mvn/version "2.1.0-M1"}
        org.flywaydb/flyway-core {:mvn/version "13.11.1"}
        org.flywaydb/flyway-mysql {:mvn/version "13.11.1"}
        org.eclipse.jetty/jetty-server {:mvn/version "12.1.14"}
        org.jsoup/jsoup {:mvn/version "1.23.2"}
        org.mariadb.jdbc/mariadb-java-client {:mvn/version "4.0.0"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:exclusions [org.eclipse.jetty/jetty-server] :mvn/version "1.15.6"}
        selmer/selmer {:mvn/version "1.13.5"}
        }}

    
